# Server
PORT=4173
APP_URL=http://localhost:4173
COOKIE_SECURE=false
DATA_FILE=data/db.json

# Admin bootstrap (required to use /admin)
# Use a unique password of at least 10 characters.
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Set true only when you intentionally want to reset the stored admin password on restart.
ADMIN_RESET_PASSWORD=false

# Billing
# Keep true for client/demo previews. Set false before real payments.
DEMO_BILLING=true

# Optional persistent free-tier storage using Supabase.
# If both are set, the app stores its state in Supabase instead of the local JSON file.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional real Stripe Checkout integration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_BUSINESS=
